# Copy to .env.local for local development. On Vercel these are set in
# Project → Settings → Environment Variables (POSTGRES_URL is injected for you
# when you attach a database, so you don't set that one by hand).

# Postgres. Vercel injects POSTGRES_URL; DATABASE_URL is accepted too.
DATABASE_URL=postgres://user:pass@host/db

# Any random string; it signs the session cookie. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth app (Settings → Developer settings → OAuth Apps).
# Callback URL: https://YOUR-SITE/api/auth/callback/github
# and http://localhost:3000/api/auth/callback/github for local work.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
